# Copy to .env and fill in real values before running `docker compose up`.

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=9drive

# --- Backend secrets (REQUIRED — no defaults, must be set explicitly) ---
JWT_ACCESS_SECRET=generate-a-random-64-char-string
TOKEN_ENCRYPTION_KEY=another-random-32-char-key

# --- Optional hardening ---
# Comma-separated user IDs allowed to call /system/* admin endpoints
ADMIN_USER_IDS=

# --- Backend ---
# DATABASE_URL defaults to postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# DIRECT_URL defaults to the same when unset
# Host ports: frontend nginx on 5174, backend on 4001 (compose maps 4001:4000)
FRONTEND_URL=http://localhost:5174
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120
RECAPTCHA_SECRET_KEY=

# --- Google OAuth (leave empty to skip auto-seed; configure via /settings) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/connected-accounts/google/callback

# --- Frontend build args ---
VITE_API_URL=http://localhost:4001
VITE_RECAPTCHA_SITE_KEY=
