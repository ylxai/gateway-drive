# Copy to frontend/.env for local development (frontend/.env is git-ignored).
# Vite embeds these variables at build time. In production (Netlify / tose.sh),
# set them as build-time environment variables instead of committing .env.

# Backend base URL. Local dev default; override in production builds.
VITE_API_URL=http://localhost:4000

# Optional reCAPTCHA site key. Blank disables the captcha UI.
VITE_RECAPTCHA_SITE_KEY=
